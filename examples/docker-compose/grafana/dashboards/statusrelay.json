    {
      "type": "timeseries",
      "title": "Incomplete snapshots",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Successful fetches that could not vouch for absence; no resolution is inferred from them.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true,
            "showPoints": "never",
